# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_management
DB_USER=postgres
DB_PASSWORD=3112

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
